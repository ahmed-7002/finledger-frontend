# ==== Clerk ====
VITE_CLERK_PUBLISHABLE_KEY=your public clerk key

# ==== Backend API base URL ====
# In dev, Vite proxies /api to the backend (see vite.config.js), so this
# can stay relative. In production, point it at your deployed API.
VITE_API_BASE_URL=/api

# ==== Cloudinary (unsigned upload preset used directly from the browser) ====
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=khaatabook_unsigned
